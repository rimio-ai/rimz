#!/bin/sh
# RimZ pre-commit gate: block a commit that would fail a fast CI gate, so
# unformatted code or a broken architectural boundary never reaches the branch.
# The checks themselves live in xtask; this shim only routes git's hook call
# there, keeping one source of truth. Slow gates (check, lint, test) stay with
# `cargo xtask gate` and CI. Install with `cargo xtask hooks`; bypass a single
# commit with `git commit --no-verify`.

# Formatting: judge staged Rust index copies, rewrite only refused files' working
# copies, and never re-stage, so partially staged files never gain hunks silently.
if ! cargo xtask fmt --staged; then
	echo >&2
	echo "pre-commit: staged Rust files above were not formatted; only their working copies were formatted where possible, nothing was re-staged. Review the diff, re-stage, and commit again." >&2
	exit 1
fi

# Architectural invariants (a load-bearing boundary; greps Rust and Markdown).
if ! cargo xtask invariants; then
	echo >&2
	echo "pre-commit: \`cargo xtask invariants\` failed — fix the boundary violation above and commit again." >&2
	exit 1
fi

# Surface budget and allowed dependencies from refactor-target.toml; `check`
# and `lint` never see them, so an overrun would otherwise surface only at the
# end of `cargo xtask gate`.
if ! cargo xtask atlas conform --ratchet; then
	echo >&2
	echo "pre-commit: \`cargo xtask atlas conform --ratchet\` failed — paste the rule it printed into refactor-target.toml with a comment naming why, and commit again." >&2
	exit 1
fi

# Documentation links and #anchors.
if ! cargo xtask docs-links; then
	echo >&2
	echo "pre-commit: \`cargo xtask docs-links\` failed — fix the broken link above and commit again." >&2
	exit 1
fi
