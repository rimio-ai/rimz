#!/usr/bin/env -S uv run python
# /// script
# requires-python = ">=3.11"
# ///
# Usage:
#   scripts/sync-repo [--branch main] [--remote origin]
#   scripts/sync-repo --loop-check
#
# Run from anywhere inside the repository. The script switches to the target
# branch, fetches the remote, fast-forwards or rebases local commits, pushes the
# result, and stashes/restores dirty target-branch work when that makes the sync
# cleanly possible.
#
# Scheduled loop form:
#   rimz loop add sync-repo \
#     --check './scripts/sync-repo --loop-check' \
#     --on fail \
#     --agent codex \
#     --prompt 'Repair the scheduled repository sync, then rerun ./scripts/sync-repo --loop-check.' \
#     --every 15m
#
# In loop-check mode, rebase conflicts exit nonzero so RimZ loop wakes the agent
# through `on = "fail"` instead of this helper spawning Codex directly.
from __future__ import annotations

import argparse
import atexit
import os
import secrets
import shutil
import signal
import socket
import subprocess
import sys
import time
from dataclasses import dataclass
from pathlib import Path


LOCK_FILES = ("token", "pid", "host", "started", "repo", "branch", "remote")
STASH_MARKER = "rimz-sync-repo.stash"
INSTALL_DEV_PATHS = (
    ".cargo",
    "Cargo.lock",
    "Cargo.toml",
    "crates",
    "rust-toolchain.toml",
    "scripts/install-dev-tools.sh",
    "xtask",
)


class CommandFailed(Exception):
    def __init__(self, args: list[str], returncode: int) -> None:
        self.args_list = args
        self.returncode = returncode
        super().__init__(f"{args[0]} exited with status {returncode}")


class FatalError(Exception):
    def __init__(self, message: str, code: int = 1) -> None:
        self.message = message
        self.code = code
        super().__init__(message)


@dataclass
class Config:
    branch: str
    remote: str
    codex_spec: str
    codex_timeout: str
    rimz_bin: str
    loop_check: bool


@dataclass
class SavedStash:
    commit: str
    message: str


def env_default(primary: str, fallback: str, default: str) -> str:
    return os.environ.get(primary) or os.environ.get(fallback) or default


def env_truthy(primary: str, fallback: str) -> bool:
    value = os.environ.get(primary) or os.environ.get(fallback) or ""
    return value.lower() in ("1", "true", "yes", "on")


def parse_args(argv: list[str]) -> Config:
    parser = argparse.ArgumentParser(
        usage=(
            "%(prog)s [--branch NAME] [--remote NAME] [--codex SPEC] "
            "[--timeout DURATION] [--loop-check]"
        ),
        allow_abbrev=False,
        epilog=(
            "Scheduled use: run this as a RimZ loop check with `on = \"fail\"`, "
            "for example `rimz loop add sync-repo --check './scripts/sync-repo "
            "--loop-check' --on fail --agent codex --prompt 'Repair the scheduled "
            "repository sync, then rerun ./scripts/sync-repo --loop-check.' "
            "--every 15m`."
        ),
    )
    parser.add_argument(
        "--branch",
        default=env_default("RIMZ_SYNC_REPO_BRANCH", "RIMZ_MAIN_GIT_BRANCH", "main"),
    )
    parser.add_argument(
        "--remote",
        default=env_default("RIMZ_SYNC_REPO_REMOTE", "RIMZ_MAIN_GIT_REMOTE", "origin"),
    )
    parser.add_argument(
        "--codex",
        default=env_default("RIMZ_SYNC_REPO_CODEX_SPEC", "RIMZ_MAIN_GIT_CODEX_SPEC", "codex"),
    )
    parser.add_argument(
        "--timeout",
        default=env_default("RIMZ_SYNC_REPO_CODEX_TIMEOUT", "RIMZ_MAIN_GIT_CODEX_TIMEOUT", "45m"),
    )
    parser.add_argument(
        "--loop-check",
        action="store_true",
        default=env_truthy("RIMZ_SYNC_REPO_LOOP_CHECK", "RIMZ_MAIN_GIT_LOOP_CHECK"),
        help="defer rebase-conflict repair to RimZ loop",
    )
    args = parser.parse_args(argv)
    return Config(
        branch=args.branch,
        remote=args.remote,
        codex_spec=args.codex,
        codex_timeout=args.timeout,
        rimz_bin=os.environ.get("RIMZ_BIN", "rimz"),
        loop_check=args.loop_check,
    )


def log(message: str) -> None:
    print(f"rimz-sync-repo: {message}", file=sys.stderr, flush=True)


def die(message: str, code: int = 1) -> None:
    raise FatalError(message, code)


def run(
    args: list[str],
    *,
    check: bool = True,
    capture: bool = False,
    quiet: bool = False,
    env: dict[str, str] | None = None,
) -> subprocess.CompletedProcess[str]:
    stdout = subprocess.PIPE if capture else (subprocess.DEVNULL if quiet else None)
    stderr = subprocess.PIPE if capture else (subprocess.DEVNULL if quiet else None)
    try:
        result = subprocess.run(
            args,
            check=False,
            env=env,
            stderr=stderr,
            stdout=stdout,
            text=True,
        )
    except FileNotFoundError:
        die(f"{args[0]} is not on PATH")
    if check and result.returncode != 0:
        raise CommandFailed(args, result.returncode)
    return result


def git(*args: str, check: bool = True, capture: bool = False, quiet: bool = False) -> subprocess.CompletedProcess[str]:
    return run(["git", *args], check=check, capture=capture, quiet=quiet)


def git_output(*args: str, quiet: bool = False) -> str:
    return git(*args, capture=True, quiet=quiet).stdout.strip()


def git_success(*args: str) -> bool:
    return git(*args, check=False, quiet=True).returncode == 0


def read_lock_file(path: Path) -> str:
    try:
        with path.open("r", encoding="utf-8") as handle:
            return handle.readline().rstrip("\n")
    except FileNotFoundError:
        return ""
    except OSError:
        return ""


class SyncRepo:
    def __init__(self, config: Config) -> None:
        self.config = config
        try:
            self.repo_root = Path(git_output("rev-parse", "--show-toplevel", quiet=True))
        except CommandFailed:
            die("run inside a git repository")
        os.chdir(self.repo_root)

        git_common_dir = Path(git_output("rev-parse", "--git-common-dir"))
        if not git_common_dir.is_absolute():
            git_common_dir = self.repo_root / git_common_dir
        self.git_common_dir = git_common_dir
        self.lock_dir = git_common_dir / "rimz-sync-repo.lock"
        self.stash_marker = git_common_dir / STASH_MARKER
        self.lock_host = socket.gethostname() or "unknown"
        self.lock_token = f"{os.getpid()}.{secrets.token_hex(4)}.{int(time.time())}"
        self.lock_acquired = False

    def acquire_lock(self) -> None:
        while True:
            try:
                self.lock_dir.mkdir()
                break
            except FileExistsError:
                if not self.maybe_clear_stale_lock():
                    raise SystemExit(0)
        self.lock_acquired = True
        atexit.register(self.cleanup_lock)
        self.install_signal_handlers()
        self.write_lock_metadata()

    def maybe_clear_stale_lock(self) -> bool:
        owner_pid = read_lock_file(self.lock_dir / "pid")
        owner_host = read_lock_file(self.lock_dir / "host")
        owner_started = read_lock_file(self.lock_dir / "started")
        started_detail = f", started {owner_started}" if owner_started else ""

        if not owner_pid:
            return self.clear_stale_lock("missing owner metadata")
        if owner_pid == "0" or not owner_pid.isdigit():
            return self.clear_stale_lock(f"invalid owner pid {owner_pid}")
        if owner_host and owner_host != self.lock_host:
            log(f"another sync-repo run may be active on {owner_host} (pid {owner_pid}{started_detail}); skipping")
            return False

        try:
            os.kill(int(owner_pid), 0)
        except ProcessLookupError:
            return self.clear_stale_lock(f"owner pid {owner_pid} is gone")
        except PermissionError:
            pass

        log(f"another sync-repo run is active (pid {owner_pid}{started_detail}); skipping")
        return False

    def clear_stale_lock(self, reason: str) -> bool:
        for name in LOCK_FILES:
            try:
                (self.lock_dir / name).unlink()
            except FileNotFoundError:
                pass
            except OSError:
                pass
        try:
            self.lock_dir.rmdir()
        except OSError:
            log("another sync-repo run is active; skipping")
            return False
        log(f"removed stale sync-repo lock: {reason}")
        return True

    def cleanup_lock(self) -> None:
        if not self.lock_acquired or not self.lock_dir.is_dir():
            return
        if read_lock_file(self.lock_dir / "token") != self.lock_token:
            return
        for name in LOCK_FILES:
            try:
                (self.lock_dir / name).unlink()
            except FileNotFoundError:
                pass
            except OSError:
                pass
        try:
            self.lock_dir.rmdir()
        except OSError:
            pass

    def install_signal_handlers(self) -> None:
        def handle(signum: int, _frame: object) -> None:
            raise SystemExit(128 + signum)

        for signum in (signal.SIGHUP, signal.SIGINT, signal.SIGTERM):
            signal.signal(signum, handle)

    def write_lock_metadata(self) -> None:
        values = {
            "token": self.lock_token,
            "pid": str(os.getpid()),
            "host": self.lock_host,
            "started": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
            "repo": str(self.repo_root),
            "branch": self.config.branch,
            "remote": self.config.remote,
        }
        for name, value in values.items():
            (self.lock_dir / name).write_text(f"{value}\n", encoding="utf-8")

    def run(self) -> int:
        self.acquire_lock()
        if not git_success("remote", "get-url", self.config.remote):
            die(f"remote {self.config.remote} is not configured")

        if self.rebase_in_progress():
            active_rebase_branch = self.rebase_branch()
            if active_rebase_branch and active_rebase_branch != self.config.branch:
                die(f"rebase in progress for {active_rebase_branch}, expected {self.config.branch}")
            self.finish_conflicted_rebase()
            log("pushing completed rebase")
            git("push", self.config.remote, self.config.branch)
            pending_stash = self.read_stash_marker()
            if pending_stash is not None:
                return self.restore_stash(pending_stash, 0)
            return 0

        self.switch_to_branch()

        stashes_to_restore: list[SavedStash] = []
        pending_stash = self.read_stash_marker()
        if pending_stash is not None:
            log(f"found pending sync stash {pending_stash.commit}; will restore after sync")
            if self.tree_dirty():
                die(
                    "pending sync stash exists and the working tree is dirty; "
                    "restore or drop the pending stash before syncing"
                )
            stashes_to_restore.append(pending_stash)

        exit_code = 0
        log_done = False
        try:
            saved_stash = self.stash_dirty_worktree()
            if saved_stash is not None:
                stashes_to_restore.append(saved_stash)
            previous_oid = git_output("rev-parse", f"refs/heads/{self.config.branch}")
            log_done = self.sync_branch()
            self.install_dev_if_code_changed(previous_oid)
        except CommandFailed as error:
            exit_code = error.returncode
        except FatalError as error:
            log(error.message)
            exit_code = error.code
        finally:
            for saved_stash in reversed(stashes_to_restore):
                restore_code = self.restore_stash(saved_stash, exit_code)
                if restore_code != 0:
                    exit_code = restore_code
                    break

        if exit_code == 0 and log_done:
            log("done")
        return exit_code

    def rebase_in_progress(self) -> bool:
        return (self.git_common_dir / "rebase-merge").is_dir() or (self.git_common_dir / "rebase-apply").is_dir()

    def rebase_branch(self) -> str:
        for state_dir in (self.git_common_dir / "rebase-merge", self.git_common_dir / "rebase-apply"):
            head_name = state_dir / "head-name"
            if head_name.is_file():
                return read_lock_file(head_name).removeprefix("refs/heads/")
        return ""

    def require_clean_tree(self) -> None:
        git("update-index", "-q", "--refresh", check=False, quiet=True)
        if not git_success("diff", "--quiet"):
            die("working tree has unstaged changes; skipping")
        if not git_success("diff", "--cached", "--quiet"):
            die("index has staged changes; skipping")
        if git_output("ls-files", "--others", "--exclude-standard"):
            die("working tree has untracked files; skipping")

    def tree_dirty(self) -> bool:
        git("update-index", "-q", "--refresh", check=False, quiet=True)
        return (
            not git_success("diff", "--quiet")
            or not git_success("diff", "--cached", "--quiet")
            or bool(git_output("ls-files", "--others", "--exclude-standard"))
        )

    def install_dev_if_code_changed(self, previous_oid: str) -> None:
        current_oid = git_output("rev-parse", f"refs/heads/{self.config.branch}")
        if current_oid == previous_oid:
            return

        changed = git(
            "diff",
            "--quiet",
            previous_oid,
            current_oid,
            "--",
            *INSTALL_DEV_PATHS,
            check=False,
            quiet=True,
        )
        if changed.returncode == 0:
            return
        if changed.returncode != 1:
            raise CommandFailed(["git", "diff", previous_oid, current_oid], changed.returncode)

        log("code changed; running cargo xtask install-dev")
        run(["cargo", "xtask", "install-dev"])
        log("development binary installed; running rimz reload")
        run([self.config.rimz_bin, "reload"])

    def current_branch(self) -> str:
        return git_output("rev-parse", "--abbrev-ref", "HEAD")

    def switch_to_branch(self) -> None:
        current = self.current_branch()
        if current == self.config.branch:
            return
        self.require_clean_tree()
        log(f"switching from {current} to {self.config.branch}")
        git("switch", self.config.branch)

    def stash_dirty_worktree(self) -> SavedStash | None:
        if not self.tree_dirty():
            return None
        message = f"rimz-sync-repo: {self.config.branch} {time.strftime('%Y-%m-%dT%H:%M:%SZ', time.gmtime())}"
        log(f"stashing dirty {self.config.branch} working tree before sync")
        git("stash", "push", "--include-untracked", "-m", message)
        commit = git_output("rev-parse", "--verify", "refs/stash")
        saved = SavedStash(commit=commit, message=message)
        self.write_stash_marker(saved)
        return saved

    def read_stash_marker(self) -> SavedStash | None:
        try:
            raw = self.stash_marker.read_text(encoding="utf-8")
        except FileNotFoundError:
            return None
        except OSError:
            return None

        values: dict[str, str] = {}
        for line in raw.splitlines():
            key, separator, value = line.partition("=")
            if separator:
                values[key] = value
        commit = values.get("commit", "")
        if not commit:
            return None
        branch = values.get("branch", "")
        remote = values.get("remote", "")
        if branch and branch != self.config.branch:
            die(f"pending sync stash is for {branch}, expected {self.config.branch}")
        if remote and remote != self.config.remote:
            die(f"pending sync stash is for {remote}, expected {self.config.remote}")
        return SavedStash(commit=commit, message=values.get("message", ""))

    def write_stash_marker(self, saved: SavedStash) -> None:
        body = "\n".join(
            [
                f"commit={saved.commit}",
                f"branch={self.config.branch}",
                f"remote={self.config.remote}",
                f"message={saved.message}",
                "",
            ]
        )
        tmp = self.stash_marker.with_name(f"{self.stash_marker.name}.{os.getpid()}.tmp")
        tmp.write_text(body, encoding="utf-8")
        os.replace(tmp, self.stash_marker)

    def clear_stash_marker(self, saved: SavedStash) -> None:
        if self.read_stash_marker_commit() != saved.commit:
            return
        try:
            self.stash_marker.unlink()
        except FileNotFoundError:
            pass
        except OSError:
            pass

    def read_stash_marker_commit(self) -> str:
        try:
            raw = self.stash_marker.read_text(encoding="utf-8")
        except FileNotFoundError:
            return ""
        except OSError:
            return ""
        for line in raw.splitlines():
            key, separator, value = line.partition("=")
            if key == "commit" and separator:
                return value
        return ""

    def restore_stash(self, saved: SavedStash, prior_exit_code: int) -> int:
        if self.rebase_in_progress():
            log(f"leaving stashed working tree changes in {saved.commit}: rebase is still in progress")
            return prior_exit_code or 1

        stash_ref = self.stash_ref_for_commit(saved.commit)
        if stash_ref is None:
            log(f"saved working tree stash {saved.commit} is missing; restore it manually")
            return 1

        log("restoring stashed working tree changes")
        result = git("stash", "pop", "--index", stash_ref, check=False)
        if result.returncode != 0:
            log(f"stashed working tree changes remain in {stash_ref}; resolve conflicts and drop it manually")
            return result.returncode or 1
        self.clear_stash_marker(saved)
        return 0

    def stash_ref_for_commit(self, commit: str) -> str | None:
        entries = git_output("stash", "list", "--format=%H%x00%gd")
        for entry in entries.splitlines():
            stash_commit, separator, ref = entry.partition("\0")
            if separator and stash_commit == commit:
                return ref
        return None

    def rebase_repair_text(self, *, loop_managed: bool) -> str:
        status_short = git_output("status", "--short", "--branch")
        command = f"./scripts/sync-repo --branch {self.config.branch} --remote {self.config.remote} --loop-check"
        next_step = (
            f"Then rerun `{command}` so it pushes the completed sync and restores any saved working-tree stash."
            if loop_managed
            else (
                f"Stop when `git status --short --branch` is clean on {self.config.branch}. "
                "Do not push; sync-repo will push after you finish."
            )
        )
        return f"""A scheduled repository sync run needs agent repair.

Repository: {self.repo_root}
Branch: {self.config.branch}
Remote: {self.config.remote}/{self.config.branch}

Current status:
{status_short}

Resolve the rebase conflicts in this repository. Preserve both upstream and local intent, follow AGENTS.md, run focused validation when practical, stage the resolved files, and finish the rebase with `GIT_EDITOR=true git rebase --continue`. {next_step}"""

    def request_loop_repair(self) -> None:
        print(self.rebase_repair_text(loop_managed=True), file=sys.stderr, flush=True)
        die('rebase conflicts need agent repair; RimZ loop should wake on `on = "fail"`')

    def spawn_codex_for_rebase(self) -> None:
        if shutil.which(self.config.rimz_bin) is None:
            die(f"rebase conflicts need Codex, but {self.config.rimz_bin} is not on PATH")

        prompt = self.rebase_repair_text(loop_managed=False)

        log(f"spawning {self.config.codex_spec} to resolve rebase conflicts")
        codex_args = [
            self.config.rimz_bin,
            "agents",
            self.config.codex_spec,
            prompt,
            "-p",
            "--timeout",
            self.config.codex_timeout,
        ]
        yolo = os.environ.get("RIMZ_SYNC_REPO_CODEX_YOLO") or os.environ.get("RIMZ_MAIN_GIT_CODEX_YOLO") or ""
        if yolo in ("1", "true", "yes"):
            codex_args.append("--yolo")
        run(codex_args)

    def finish_conflicted_rebase(self) -> None:
        if self.config.loop_check:
            self.request_loop_repair()
        self.spawn_codex_for_rebase()
        if self.rebase_in_progress():
            die("Codex returned before the rebase completed")
        current = self.current_branch()
        if current != self.config.branch:
            die(f"Codex completed the rebase on {current}, expected {self.config.branch}")
        self.require_clean_tree()

    def sync_branch(self) -> bool:
        remote_ref = f"refs/remotes/{self.config.remote}/{self.config.branch}"
        local_ref = f"refs/heads/{self.config.branch}"

        log(f"fetching {self.config.remote}")
        git("fetch", "--prune", self.config.remote)

        if not git_success("show-ref", "--verify", "--quiet", remote_ref):
            log(f"{self.config.remote}/{self.config.branch} does not exist; pushing {self.config.branch} and setting upstream")
            git("push", "-u", self.config.remote, self.config.branch)
            return False

        local_oid = git_output("rev-parse", local_ref)
        remote_oid = git_output("rev-parse", remote_ref)

        if git_success("merge-base", "--is-ancestor", local_oid, remote_oid):
            log(f"fast-forwarding {self.config.branch} to {self.config.remote}/{self.config.branch}")
            git("merge", "--ff-only", remote_ref)
            log(f"pushing {self.config.branch}")
            git("push", self.config.remote, self.config.branch)
        elif git_success("merge-base", "--is-ancestor", remote_oid, local_oid):
            log(f"{self.config.branch} is ahead of {self.config.remote}/{self.config.branch}")
            log(f"pushing {self.config.branch}")
            git("push", self.config.remote, self.config.branch)
        else:
            log(f"{self.config.branch} diverged from {self.config.remote}/{self.config.branch}; rebasing local commits")
            if git("rebase", remote_ref, check=False).returncode == 0:
                log(f"pushing rebased {self.config.branch}")
                git("push", self.config.remote, self.config.branch)
            else:
                self.finish_conflicted_rebase()
                log("pushing Codex-resolved rebase")
                git("push", self.config.remote, self.config.branch)
        return True


def main(argv: list[str]) -> int:
    config = parse_args(argv)
    try:
        return SyncRepo(config).run()
    except FatalError as error:
        log(error.message)
        return error.code
    except CommandFailed as error:
        return error.returncode


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
